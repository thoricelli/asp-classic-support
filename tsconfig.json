{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2024",
		"lib": [
			"ES2024"
		],
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"alwaysStrict": true,
		"removeComments": true
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}